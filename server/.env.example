# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed website origins (your Vercel URL in production)
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB Atlas connection string) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/advocate_site?retryWrites=true&w=majority

# --- Auth ---
# Long random string, at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- First admin account (used by `npm run seed`) ---
ADMIN_EMAIL=ghulammujtaba1976@gmail.com
ADMIN_PASSWORD=ChangeThisPassword123
ADMIN_NAME=Ghulam Mujtaba

# --- File storage (Cloudinary). Leave empty in development to store files in server/uploads ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URL of this API (only needed for local file storage behind a proxy)
PUBLIC_URL=
